# Build-time settings only. None of these are exposed to the browser and none are secrets.
# There are no VITE_ client variables yet; any future one must start with VITE_ and never hold a secret.

# Base path for the bundle. Default "./" works from any sub-path (for example GitHub Pages /<repo>/).
# Set an absolute path such as /transmission-pending/ only if a host needs it.
BASE_PATH=

# Set to 1 to force strict facts checks locally (CI=true turns them on automatically):
# refuses dirty trees, unavailable fact groups and a !draft intro template.
FACTS_STRICT=
